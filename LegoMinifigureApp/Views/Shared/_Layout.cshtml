<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] – Minifigure Collection</title>
	<script src="~/js/theme.js" asp-append-version="true"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
	<header>
		<nav class="navbar navbar-expand-sm navbar-brick mb-4" data-bs-theme="dark">
			<div class="container">
				<a class="navbar-brand" asp-area="" asp-controller="Minifigures" asp-action="Index">
					<span class="brand-brick" aria-hidden="true"></span>Minifigure Collection
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
						aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="publicNav">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link" asp-area="" asp-controller="Minifigures" asp-action="Index">Collection</a>
						</li>
					</ul>
					<ul class="navbar-nav">
						<li class="nav-item">
							<button type="button" class="nav-link btn btn-link theme-toggle" data-theme-toggle>
								<span data-theme-icon aria-hidden="true"></span>
								<span data-theme-label></span>
							</button>
						</li>
					</ul>
					<partial name="_LoginPartial" />
				</div>
			</div>
		</nav>
	</header>

	<main role="main" class="container flex-grow-1 pb-5">
		@RenderBody()
	</main>

	<footer class="site-footer py-3">
		<div class="container small">
			&copy; 2026 Minifigure Collection · A personal fan collection, not affiliated with the LEGO Group ·
			<a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>