@using LegoMinifigureApp.Authorization
@if (User.Identity?.IsAuthenticated == true)
{
	<ul class="navbar-nav">
		@if (User.IsInRole(AppRoles.Admin))
		{
			<li class="nav-item">
				<a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">View admin site</a>
			</li>
		}
		<li class="nav-item">
			<span class="nav-link text-dark">@User.Identity.Name</span>
		</li>
		<li class="nav-item">
			<form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
				<button type="submit" class="nav-link btn btn-link text-dark">Log out</button>
			</form>
		</li>
	</ul>
}