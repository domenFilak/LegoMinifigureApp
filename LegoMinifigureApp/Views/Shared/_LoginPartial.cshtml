@using LegoMinifigureApp.Authorization
<ul class="navbar-nav">
	@if (User.Identity?.IsAuthenticated == true)
	{
		@if (User.IsInRole(AppRoles.Admin))
		{
			<li class="nav-item">
				<a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">View admin site</a>
			</li>
		}
		<li class="nav-item">
			<span class="nav-link">@User.Identity.Name</span>
		</li>
		<li class="nav-item">
			<form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
				<button type="submit" class="nav-link btn btn-link">Log out</button>
			</form>
		</li>
	}
	else
	{
		<li class="nav-item">
			<a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
			   Log in
		   </a>
		</li>
	}
</ul>