@model int

@{
	ViewData["Title"] = "Offer sent";
}

<div class="error-page">
	<div class="error-brick error-brick-yellow" aria-hidden="true">✓</div>

	<h1 class="mb-3">Offer sent!</h1>
	<p class="text-muted mb-4">Thanks! I'll read your offer and reply to your e-mail as soon as I can.</p>

	<div class="d-flex flex-wrap justify-content-center gap-2">
		<a asp-controller="Minifigures" asp-action="Details" asp-route-id="@Model" class="btn btn-primary">Back to figure</a>
		<a asp-controller="Minifigures" asp-action="Index" class="btn btn-outline-secondary">Back to collection</a>
	</div>
</div>