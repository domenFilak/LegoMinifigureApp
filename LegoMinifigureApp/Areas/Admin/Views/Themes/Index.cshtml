@model ThemeIndexViewModel

@{
	ViewData["Title"] = "Themes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="mb-0">@ViewData["Title"]</h1>
	<a asp-action="Create" class="btn btn-primary">Add theme</a>
</div>

@if (!Model.HasThemes)
{
	<p class="text-muted">No themes yet.</p>
}
else
{
	<div class="card shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th>Name</th>
						<th class="text-end">Created</th>
						<th class="text-end">Owned</th>
						<th class="text-end">Archived</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var theme in Model.Themes)
					{
						<tr>
							<td>@theme.Name</td>
							<td class="text-end">
								<time datetime="@UtcDates.ToIso(theme.CreatedAt)" data-local-time>@UtcDates.ToFallbackText(theme.CreatedAt)</time>
							</td>
							<td class="text-end">@theme.OwnedCount</td>
							<td class="text-end">@theme.ArchivedCount</td>
							<td class="text-end text-nowrap">
								<a asp-action="Edit" asp-route-id="@theme.Id" class="btn btn-sm btn-outline-secondary">Rename</a>

								@if (theme.CanDelete)
								{
									<a asp-action="Delete" asp-route-id="@theme.Id" class="btn btn-sm btn-outline-danger">Delete</a>
								}
								else
								{
									<span class="d-inline-block" tabindex="0"
										  title="Theme has figures and can't be deleted">
										<button type="button" class="btn btn-sm btn-outline-danger" disabled>Delete</button>
									</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}