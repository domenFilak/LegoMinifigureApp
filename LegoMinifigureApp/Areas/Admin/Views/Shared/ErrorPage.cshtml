@model ErrorPageViewModel

@{
	ViewData["Title"] = Model.Title;
}

<div class="error-page">
	<div class="error-brick @Model.BrickClass" aria-hidden="true">@Model.StatusCode</div>

	<h1 class="mb-3">@Model.Title</h1>
	<p class="text-muted mb-4">@Model.Message</p>

	<a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to dashboard</a>

	@if (Model.ReferenceId is not null)
	{
		<p class="small text-muted mt-4 mb-0">Error reference: <code>@Model.ReferenceId</code></p>
	}
</div>