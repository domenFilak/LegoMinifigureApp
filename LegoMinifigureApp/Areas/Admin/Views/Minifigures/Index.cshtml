@model MinifigureIndexViewModel

@{
	ViewData["Title"] = "Minifigures";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="mb-0">@ViewData["Title"]</h1>
	<a asp-action="Create" class="btn btn-primary">Add minifigure</a>
</div>

<!--filters section, GET form; values are put into URL-->
<form asp-action="Index" method="get" class="card card-body shadow-sm mb-4">
	<div class="row g-2 align-items-end">
		<div class="col-md-4">
			<label asp-for="Search" class="form-label">Search</label>
			<input asp-for="Search" class="form-control" placeholder="Name or BrickLink ID" />
		</div>
		<div class="col-md-3">
			<label asp-for="ThemeId" class="form-label">Theme</label>
			<select asp-for="ThemeId" asp-items="Model.ThemeOptions" class="form-select">
				<option value="">All themes</option>
			</select>
		</div>
		<div class="col-md-3">
			<label asp-for="Listing" class="form-label">Listing</label>
			<select asp-for="Listing" asp-items="Model.ListingOptions" class="form-select"></select>
		</div>
		<div class="col-md-2 d-flex gap-2">
			<button type="submit" class="btn btn-outline-primary w-100">Filter</button>
			@if (Model.HasActiveFilters)
			{
				<a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters">✕</a>
			}
		</div>
	</div>
</form>

@if (!Model.HasItems)
{
	<div class="card card-body shadow-sm text-center text-muted">
		@if (Model.HasActiveFilters)
		{
			<p class="mb-2">No figures match your filters.</p>
			<a asp-action="Index">Clear filters</a>
		}
		else
		{
			<p class="mb-0">No figures in your collection yet.</p>
		}
	</div>
}
else
{
	<div class="card shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th style="width: 64px;"></th>
						<th>Name</th>
						<th>Theme</th>
						<th>Condition</th>
						<th>Listing</th>
						<th class="text-end">Created</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var figure in Model.Items)
					{
						<tr>
							<td><img src="@figure.ImageUrl" alt="@figure.Name" class="figure-thumb-sm" /></td>
							<td>
								<div class="fw-semibold">@figure.Name</div>
								<div class="small text-muted">@figure.BrickLinkId</div>
							</td>
							<td>@figure.ThemeName</td>
							<td>@figure.Condition</td>
							<td>
								@if (figure.IsForSale)
								{
									<span class="badge text-bg-success">For sale · @figure.AskingPriceText</span>
								}
								@if (figure.IsForTrade)
								{
									<span class="badge text-bg-info">For trade</span>
								}
							</td>
							<td class="text-end">
								<time datetime="@UtcDates.ToIso(figure.CreatedAt)" data-local-time>@UtcDates.ToFallbackText(figure.CreatedAt)</time>
							</td>
							<td class="text-end">
								<a asp-action="Details" asp-route-id="@figure.Id" class="btn btn-sm btn-outline-secondary">Manage</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!--paging-->
	<div class="d-flex justify-content-between align-items-center mt-3">
		<span class="text-muted small">
			Showing @Model.FirstItemNumber–@Model.LastItemNumber of @Model.TotalCount
		</span>

		@if (Model.TotalPages > 1)
		{
			<nav aria-label="Minifigure pages">
				<ul class="pagination mb-0">
					<li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
						<a class="page-link" asp-action="Index"
						   asp-all-route-data="Model.RouteValuesForPage(Model.Page - 1)">Previous</a>
					</li>
					<li class="page-item disabled">
						<span class="page-link">Page @Model.Page of @Model.TotalPages</span>
					</li>
					<li class="page-item @(Model.HasNextPage ? "" : "disabled")">
						<a class="page-link" asp-action="Index"
						   asp-all-route-data="Model.RouteValuesForPage(Model.Page + 1)">Next</a>
					</li>
				</ul>
			</nav>
		}
	</div>
}